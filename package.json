{
  "name": "greenroom",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});fs.copyFileSync('index.html','www/index.html');fs.cpSync('fonts','www/fonts',{recursive:true});fs.cpSync('lib','www/lib',{recursive:true})\"",
    "ios": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  },
  "dependencies": {
    "@capacitor-community/media": "^9.1.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4"
  }
}
